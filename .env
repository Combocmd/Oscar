# ─── Oscar DCA Bot Configuration ───
# Mode de fonctionnement
# true  = Paper trading (simulation, aucun argent réel)
# false = Trading réel (nécessite API keys Binance avec droits trade)
DRY_RUN=True

# Paramètres DCA
SYMBOL=BTC/USDT              # Paire à trader
WEEKLY_AMOUNT=7.5            # Montant en USDT par achat hebdomadaire (30$ / 4 = 7.5$)
STARTING_BALANCE=30          # Capital fictif initial (30$)

# Planification (UTC) — Le Sénégal = UTC+0 (GMT)
# BUY_DAY: 0=Lundi, 1=Mardi, ..., 6=Dimanche
BUY_DAY=0
BUY_HOUR=0                   # Heure UTC (0-23) → 00:00 = minuit UTC = 00:00 au Sénégal
BUY_MINUTE=0                 # Minute (0-59)

# ─── Notifications Telegram (optionnel) ───
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789

# ─── API Binance (uniquement si DRY_RUN=False) ───
# BINANCE_API_KEY=your_api_key
# BINANCE_API_SECRET=your_api_secret