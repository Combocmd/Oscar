# ─── Oscar DCA Bot Configuration ───
# Copie ce fichier en .env et modifie les valeurs

# Mode de fonctionnement
# true  = Paper trading (simulation, aucun argent réel)
# false = Trading réel (nécessite API keys Binance avec droits trade)
DRY_RUN=True

# Paramètres DCA
SYMBOL=BTC/USDT              # Paire à trader (BTC/USDT, ETH/USDT, etc.)
WEEKLY_AMOUNT=7.5            # Montant en USDT par achat hebdomadaire
STARTING_BALANCE=30          # Capital fictif initial (pour paper trading)

# Planification (UTC)
# BUY_DAY: 0=Lundi, 1=Mardi, ..., 6=Dimanche
BUY_DAY=0
BUY_HOUR=0                   # Heure UTC (0-23)
BUY_MINUTE=0                 # Minute (0-59)

# ─── Notifications Telegram (optionnel) ───
# 1. Crée un bot via @BotFather sur Telegram
# 2. Récupère le token et ton chat_id (via @userinfobot)
# 3. Décommente et remplis ci-dessous
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789

# ─── API Binance (uniquement si DRY_RUN=False) ───
# Crée une API Key sur Binance (Spot trading, SANS retrait)
# BINANCE_API_KEY=your_api_key
# BINANCE_API_SECRET=your_api_secret